<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ibtissam_background"
    android:padding="20dp"
    tools:context=".IbtissamMainActivity">

    <TextView
        android:id="@+id/tvTitleIbtissam"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ibtissam Book ✨"
        android:textColor="@color/ibtissam_text_primary"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLoadIbtissamContacts"
        style="@style/IbtissamButtonStyle"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="📱 Charger mes contacts"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitleIbtissam"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSyncIbtissam"
        style="@style/IbtissamButtonStyle"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="☁️ Synchroniser vers mon cloud"
        android:layout_marginTop="12dp"
        app:backgroundTint="@color/ibtissam_accent"
        app:layout_constraintTop_toBottomOf="@id/btnLoadIbtissamContacts"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilSearchIbtissam"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="Rechercher (Nom ou Numéro)"
        app:boxCornerRadiusTopStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusBottomEnd="16dp"
        app:boxBackgroundColor="@color/white"
        app:boxStrokeColor="@color/ibtissam_primary_dark"
        app:layout_constraintTop_toBottomOf="@id/btnSyncIbtissam"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnSearchIbtissam"
        android:layout_marginEnd="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etKeywordIbtissam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ibtissam_text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSearchIbtissam"
        style="@style/IbtissamButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:text="🔍"
        app:cornerRadius="16dp"
        app:layout_constraintTop_toTopOf="@id/tilSearchIbtissam"
        app:layout_constraintBottom_toBottomOf="@id/tilSearchIbtissam"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvContactsIbtissam"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tilSearchIbtissam"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_ibtissam_contact" />

</androidx.constraintlayout.widget.ConstraintLayout>
